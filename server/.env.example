# ===================================================
# Node.js User Authentication System - Server Environment Variables
# ===================================================

# Port for Express server to listen on
PORT=5000

# Application environment: development | production | test
NODE_ENV=development

# MongoDB Connection String:
# Local MongoDB: mongodb://127.0.0.1:27017/auth_lab_db
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/auth_lab_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/auth_lab_db

# Secret key used to sign and verify JSON Web Tokens (min 32 characters recommended)
JWT_SECRET=college_lab_jwt_super_secure_secret_key_2026_demo

# Expiration timeframe for JWT tokens (e.g. 1d, 7d, 24h, 3600s)
JWT_EXPIRES_IN=1d

# Allowed Frontend URL for CORS configuration (must match the Vite dev server origin)
FRONTEND_URL=http://localhost:5173

# Name of the HttpOnly cookie used to store the JWT token
COOKIE_NAME=auth_token

# Cookie max age in milliseconds (1 day = 86400000 ms)
COOKIE_MAX_AGE_MS=86400000
